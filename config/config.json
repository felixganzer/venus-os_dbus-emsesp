{
  "mode": "rest_with_dummy_fallback",
  "ems_esp": {
    "base_url": "http://ems-esp.local",
    "access_token": "",
    "verify_tls": true,
    "timeout_seconds": 5,
    "poll_interval_seconds": 10,
    "minimum_successful_endpoints": 1,
    "endpoints": {
      "boiler": "/api/boiler",
      "thermostat": "/api/thermostat",
      "heatpump": "/api/heatpump",
      "system": "/api/system"
    }
  },
  "fallback": {
    "enabled": true,
    "after_consecutive_failures": 1,
    "rest_retry_seconds": 30
  },
  "simulation_control": {"enabled_at_start": true},
  "model": {"aux_heater_nominal_power_w": 9000},
  "dummy": {
    "scenario_duration_seconds": 1800,
    "start_time_offset_seconds": 0,
    "power_variation_fraction": 0.18,
    "variation_seed": 5800
  },
  "electrical": {"voltage_v": 230.0, "position": 0},
  "devices": {
    "heating": {"service_name":"com.victronenergy.heatpump.emsesp_heating","device_instance":280,"custom_name":"Bosch 5800i Heizung","product_name":"EMS-ESP Raumheizung","product_id":65535},
    "dhw": {"service_name":"com.victronenergy.heatpump.emsesp_dhw","device_instance":281,"custom_name":"Bosch 5800i Warmwasser","product_name":"EMS-ESP Warmwasser","product_id":65535},
    "aux_heater": {"service_name":"com.victronenergy.heatpump.emsesp_aux","device_instance":282,"custom_name":"Bosch 5800i Heizstab","product_name":"EMS-ESP Heizstab","product_id":65535}
  },
  "emsesp_mapping": {
    "outside_temperature_c": ["boiler.outdoortemp","boiler.outside_temp","boiler.outdoor_temp","heatpump.outdoortemp","heatpump.outside_temp","heatpump.outdoor_temp"],
    "flow_temperature_c": ["boiler.curflowtemp","boiler.cur_flow_temp","boiler.flow_temp","boiler.hptc1","heatpump.curflowtemp","heatpump.cur_flow_temp","heatpump.flow_temp"],
    "return_temperature_c": ["boiler.rettemp","boiler.return_temp","boiler.ret_temp","boiler.hptc0","heatpump.rettemp","heatpump.return_temp","heatpump.ret_temp"],
    "dhw_temperature_c": ["boiler.dhw.curtemp2","boiler.dhw.cur_temp","boiler.dhw.curtemp","boiler.dhw.temp","boiler.hptw1","heatpump.dhw.curtemp","heatpump.dhw.temp"],
    "target_flow_temperature_c": ["thermostat.hc1.targetflowtemp","thermostat.hc1.target_flow_temp","boiler.selflowtemp"],
    "dhw_target_temperature_c": ["boiler.dhw.seltemp","boiler.dhw.set_temp","boiler.dhw.target_temp","thermostat.hc1.dhw.targettemp","thermostat.hc1.dhw.target_temp"],
    "system_pressure_bar": ["boiler.syspress","boiler.system_pressure"],
    "primary_flow_l_h": ["boiler.pc0flow","boiler.primary_flow_l_h"],
    "activity": ["boiler.hpactivity","boiler.hp_activity","heatpump.hpactivity","heatpump.hp_activity"],
    "heating_active": ["boiler.heatingactive","boiler.heating_active"],
    "dhw_active": ["boiler.tapwateractive","boiler.tapwater_active","boiler.dhw.charging","boiler.dhw.charging_active"],
    "compressor_active": ["boiler.hpcompon","boiler.hp_comp_on","heatpump.hpcompon","heatpump.hp_comp_on"],
    "compressor_speed_percent": ["boiler.hpcompspd","boiler.hp_comp_speed","boiler.curburnpow"],
    "aux_heater_level_percent": ["boiler.auxheaterlevel","boiler.aux_heater_level","boiler.auxheaterlevelpercent"],
    "aux_heater_active": ["boiler.elheatstep1","boiler.elheatstep2","boiler.elheatstep3","boiler.auxheateractive","boiler.aux_heater_active"],
    "compressor_electrical_power_w": ["boiler.hpcurrpower","boiler.hp_current_power","heatpump.hpcurrpower","heatpump.hp_current_power"],
    "aux_heater_power_w": ["boiler.auxheaterpower","boiler.aux_heater_power_w"],
    "thermal_power_kw": ["boiler.hppower","boiler.hp_power","heatpump.hppower","heatpump.hp_power"],
    "cop": ["boiler.cop","boiler.coefficient_of_performance","heatpump.cop","heatpump.coefficient_of_performance"],
    "electrical_energy_total_kwh": ["boiler.metertotal","boiler.meter_total","boiler.nrgconstotal"],
    "electrical_energy_compressor_kwh": ["boiler.metercomp","boiler.meter_comp","boiler.nrgconscomptotal"],
    "electrical_energy_aux_heater_kwh": ["boiler.metereheat","boiler.meter_aux_heater","boiler.auxelecheatnrgconstotal"],
    "electrical_energy_heating_kwh": ["boiler.meterheat","boiler.meter_heating","boiler.nrgconscompheating"],
    "electrical_energy_dhw_kwh": ["boiler.dhw.meter","boiler.dhw.meter_energy","boiler.dhw.nrgconscomp"],
    "electrical_energy_cooling_kwh": ["boiler.metercool","boiler.meter_cooling","boiler.nrgconscompcooling"],
    "thermal_energy_total_kwh": ["boiler.nrgtotal","boiler.nrg_total","boiler.nrgsupptotal"],
    "thermal_energy_heating_kwh": ["boiler.nrgheat","boiler.nrg_heating","boiler.nrgsuppheating"],
    "thermal_energy_dhw_kwh": ["boiler.dhw.nrg","boiler.dhw.nrg_energy","boiler.dhw.nrgsupp"],
    "thermal_energy_cooling_kwh": ["boiler.nrgcool","boiler.nrg_cooling","boiler.nrgsuppcooling"],
    "runtime_total_minutes": ["boiler.uptimetotal","boiler.uptime_total"],
    "runtime_active_minutes": ["boiler.uptimecontrol","boiler.uptime_control"],
    "runtime_heating_minutes": ["boiler.uptimecompheating","boiler.uptime_heating"],
    "runtime_dhw_minutes": ["boiler.dhw.uptimecomp","boiler.dhw.uptime_comp"],
    "runtime_cooling_minutes": ["boiler.uptimecompcooling","boiler.uptime_cooling"],
    "compressor_starts_total": ["boiler.totalcompstarts","boiler.total_comp_starts"],
    "compressor_starts_heating": ["boiler.heatingstarts","boiler.heating_starts"],
    "compressor_starts_dhw": ["boiler.dhw.startshp","boiler.dhw.starts_hp"],
    "compressor_starts_cooling": ["boiler.coolingstarts","boiler.cooling_starts"]
  },
  "generic_input_defaults": {"show_ui_input":6,"group":"Bosch 5800i Status"},
  "telemetry_display": {
    "operating_status":{"name":"Betriebsstatus","type":0,"labels":["Standby","Heizen","Warmwasser","Abtauen","Kühlen"]},
    "outside_temperature":{"name":"Außentemperatur","type":3,"unit":"/Temperature","range_min":-25,"range_max":45,"decimals":1},
    "flow_temperature":{"name":"Vorlauftemperatur","type":3,"unit":"/Temperature","range_min":0,"range_max":70,"decimals":1},
    "return_temperature":{"name":"Rücklauftemperatur","type":3,"unit":"/Temperature","range_min":0,"range_max":70,"decimals":1},
    "dhw_temperature":{"name":"Warmwasser","type":3,"unit":"/Temperature","range_min":0,"range_max":70,"decimals":1},
    "cop":{"name":"COP","type":2,"unit":"","range_min":0,"range_max":6,"decimals":2},
    "compressor":{"name":"Verdichter","type":0,"labels":["/off","/on"]},
    "aux_heater":{"name":"Heizstab","type":0,"labels":["/off","/on"]}
  },
  "counters":{"state_file":"/data/venus-os_dbus-emsesp/state/counters.json","save_interval_seconds":60}
}
